# Private planning notes; keep out of version control.
PLAN.md
.claude/settings.local.json

# Server details kept out of the public repo (origin IPs, VNC console, zone IDs).
ops/SERVER.local.md

# Obsidian vault settings (local editor state).
.obsidian/

# Python and tool caches.
.venv/
__pycache__/
*.egg-info/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Pipeline and site working output. build/*.json, build/*.md and
# build/specimens/ are committed; these are not. build/review/ and
# build/review-pack/ are the owner's review aids and may show values that
# rulings T2 and T4 keep private.
build/stage/
build/state/
build/site/
build/cache/
build/review/
build/review-pack/
# tff-site build stages the site here and swaps it in; a killed build leaves one behind,
# which would make the tree look dirty to the next build's commit check.
build/.site-*.tmp

# Local research notes, private server notes and secrets.
research/
ops/*.local.md
.env
