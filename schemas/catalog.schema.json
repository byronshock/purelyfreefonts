{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trulyfreefonts.com/schemas/catalog/0.1.0-draft",
  "title": "catalog.json",
  "description": "The full ranked catalog (methodology §7, milestone-1 step 15), written by stage 'export' (src/tff_catalog/export.py) and documented in docs/catalog-schema.md. catalog-site.json is derived from it. Cross-file rules (every font's sources object names exactly the sources in sources[], value only where publish_raw allows, the §9 hard checks) are checked by tff_catalog.validate, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_license",
    "fonts",
    "run",
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_commit",
        "config_sha256",
        "date",
        "generator",
        "method_version",
        "ranking_toml_sha256"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "method_version": {
          "$ref": "#/$defs/date"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ranking_toml_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "generator": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "data_license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisional",
        "spdx",
        "url"
      ],
      "properties": {
        "spdx": {
          "const": "CC-BY-SA-4.0"
        },
        "provisional": {
          "description": "Ruling T5 (2026-09-25) made CC BY-SA 4.0 final.",
          "const": false
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collector",
          "data_date",
          "fetched_at",
          "group",
          "id",
          "publish_raw",
          "ruler_overlap",
          "stale",
          "survey",
          "weight"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/token"
          },
          "collector": {
            "$ref": "#/$defs/token"
          },
          "group": {
            "enum": [
              "arch",
              "debian",
              "flutter",
              "fot",
              "github_counters",
              "google",
              "homebrew",
              "http_archive",
              "jsdelivr",
              "nerd",
              "npm_registry"
            ]
          },
          "survey": {
            "enum": [
              "desktop",
              "project"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "publish_raw": {
            "type": "boolean"
          },
          "data_date": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/date"
              }
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "stale": {
            "type": "boolean"
          },
          "ruler_overlap": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "category",
          "is_monospace",
          "superfamily_id",
          "aliases",
          "related",
          "license",
          "font_file",
          "latin",
          "formats",
          "preview_ok",
          "preview",
          "preinstalled_on",
          "pulled_in_by",
          "links",
          "first_seen",
          "flags",
          "ranks",
          "sources"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "family": {
            "$ref": "#/$defs/name"
          },
          "category": {
            "enum": [
              "sans-serif",
              "serif",
              "display",
              "handwriting",
              "monospace"
            ]
          },
          "is_monospace": {
            "type": "boolean"
          },
          "superfamily_id": {
            "description": "The superfamily from data/superfamilies.csv, or null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "relation"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/name"
                },
                "relation": {
                  "enum": [
                    "rename",
                    "build",
                    "package",
                    "postscript",
                    "bundle",
                    "sibling"
                  ]
                }
              }
            }
          },
          "related": {
            "description": "Families derived from or closely related to this one (Adwaita Sans is derived from Inter).",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "note": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attribution",
              "attribution_required",
              "checked_on",
              "class",
              "name",
              "redistributable",
              "spdx",
              "text_sha256",
              "text_url",
              "verified_level"
            ],
            "properties": {
              "spdx": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:() -]*$"
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "class": {
                "$ref": "#/$defs/token"
              },
              "redistributable": {
                "type": "boolean"
              },
              "attribution_required": {
                "type": "boolean"
              },
              "attribution": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/text"
                  }
                ]
              },
              "text_url": {
                "$ref": "#/$defs/https_url"
              },
              "verified_level": {
                "enum": [
                  "L1",
                  "L2",
                  "L3",
                  "ruling"
                ]
              },
              "text_sha256": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/sha256"
                  }
                ]
              },
              "checked_on": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/date"
                  }
                ]
              }
            },
            "if": {
              "properties": {
                "attribution_required": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "attribution": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "attribution": {
                  "const": null
                }
              }
            }
          },
          "font_file": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "format",
                  "sha256",
                  "size",
                  "url"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/https_url"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "format": {
                    "enum": [
                      "ttf",
                      "otf",
                      "woff2",
                      "woff"
                    ]
                  }
                }
              }
            ]
          },
          "latin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "coverage"
            ],
            "properties": {
              "coverage": {
                "enum": [
                  "basic",
                  "extended"
                ]
              },
              "basis": {
                "enum": [
                  "gf_metadata",
                  "owner_allowlist",
                  "glyph_test"
                ]
              }
            }
          },
          "formats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "static",
              "variable"
            ],
            "properties": {
              "variable": {
                "type": "boolean"
              },
              "static": {
                "type": "boolean"
              }
            },
            "not": {
              "properties": {
                "variable": {
                  "const": false
                },
                "static": {
                  "const": false
                }
              }
            }
          },
          "preview_ok": {
            "type": "boolean"
          },
          "preview": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^specimens/[a-z0-9-]+\\.svg$"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            ]
          },
          "preinstalled_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system"
              ],
              "properties": {
                "system": {
                  "$ref": "#/$defs/token"
                }
              }
            }
          },
          "pulled_in_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system",
                "package"
              ],
              "properties": {
                "system": {
                  "$ref": "#/$defs/token"
                },
                "package": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_:@/-]*$"
                },
                "share": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "designer",
              "nerd",
              "primary"
            ],
            "properties": {
              "primary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/https_url"
                  },
                  "label": {
                    "$ref": "#/$defs/text"
                  },
                  "note": {
                    "description": "What a visitor should know before following the link (an override's primary_note), shown under it in the font's details.",
                    "$ref": "#/$defs/text"
                  }
                }
              },
              "designer": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "$ref": "#/$defs/https_url"
                      },
                      "label": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                ]
              },
              "nerd": {
                "description": "The page of the font's Nerd Font build, or null (owner rulings of 2026-09-28 and 2026-09-29, TASK-2): the maker's own release page when the maker publishes one, else the build's folder in the Nerd Fonts repository at the current release tag. The label names the build.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "$ref": "#/$defs/https_url"
                      },
                      "label": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                ]
              }
            }
          },
          "first_seen": {
            "$ref": "#/$defs/date"
          },
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/token"
            },
            "description": "Sorted tokens: too_new, gate_held, no_deliberate_evidence, the correction flags (parent_merge, bundle_only, dependency_review, stale_sync) and the specimen flags (specimen_failed, specimen_name_only, specimen_hash_mismatch)."
          },
          "ranks": {
            "type": "object",
            "required": [
              "overall"
            ],
            "propertyNames": {
              "$ref": "#/$defs/rank_key"
            },
            "additionalProperties": {
              "$ref": "#/$defs/rank_entry"
            },
            "description": "One entry per rank key published this run whose universe includes the font: every key, except coding (monospace fonts only) and rising (from the third month of history)."
          },
          "sources": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/token"
            },
            "additionalProperties": {
              "$ref": "#/$defs/source_entry"
            },
            "description": "One entry per engine source id. value appears only for sources whose publish_raw is true (validate.py checks it against sources[]); Google (ruling T2) and Fonts Over Time (ruling T4) never carry one.",
            "properties": {
              "google": {
                "allOf": [
                  {
                    "$ref": "#/$defs/source_entry"
                  },
                  {
                    "not": {
                      "required": [
                        "value"
                      ]
                    }
                  }
                ]
              },
              "fot": {
                "allOf": [
                  {
                    "$ref": "#/$defs/source_entry"
                  },
                  {
                    "not": {
                      "required": [
                        "value"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "preview_ok": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "preview": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "preview_ok": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "license": {
                  "properties": {
                    "redistributable": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "is_monospace": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "ranks": {
                  "not": {
                    "required": [
                      "coding"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s\"<>]+$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "token": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(.*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(.*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "rank_key": {
      "enum": [
        "overall",
        "desktop_chosen",
        "desktop_installed",
        "project",
        "coding",
        "dev_apps",
        "rising"
      ]
    },
    "rank_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band",
        "gate_held",
        "groups",
        "order",
        "previous_score",
        "range",
        "rank",
        "score",
        "tier",
        "unranked"
      ],
      "properties": {
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "band": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The band label ('101–250', '251–500', '501+') for an order past the exact top."
        },
        "order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C",
            null
          ]
        },
        "range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "items": false
            }
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "previous_score": {
          "description": "This font's score in this rank in the last published catalog (state published_scores), on the same scale as score, or null if it had none there. Before any catalog has been published it equals score, so nothing shows as moved (owner ruling of 2026-09-30, score_previous_bootstrap). Kept for the rising and falling markers of Backlog TASK-4.",
          "type": [
            "number",
            "null"
          ]
        },
        "groups": {
          "type": "integer",
          "minimum": 0
        },
        "gate_held": {
          "type": "boolean"
        },
        "unranked": {
          "enum": [
            "no_deliberate_evidence",
            "no_evidence",
            "too_new",
            null
          ]
        }
      },
      "description": "A font's place in one rank. Ranked: an exact rank (1-100) or a band, plus order, tier and range. Unranked: every placement field null and a reason. score and groups describe the fused score either way.",
      "if": {
        "properties": {
          "unranked": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "rank": {
            "const": null
          },
          "band": {
            "const": null
          },
          "order": {
            "const": null
          },
          "tier": {
            "const": null
          },
          "range": {
            "const": null
          },
          "gate_held": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "order": {
            "type": "integer"
          },
          "tier": {
            "type": "string"
          },
          "range": {
            "type": "array"
          }
        },
        "oneOf": [
          {
            "properties": {
              "rank": {
                "type": "integer"
              },
              "band": {
                "const": null
              },
              "gate_held": {
                "const": false
              }
            }
          },
          {
            "properties": {
              "rank": {
                "const": null
              },
              "band": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "source_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rank_in_source",
        "z",
        "weight_used",
        "reason",
        "abstains_in"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed",
            "censored",
            "not_covered",
            "too_new"
          ]
        },
        "rank_in_source": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Competition rank (1, 2, 2, 4) among the source's observed values; null unless observed or when the terms ruling hides ranks."
        },
        "z": {
          "type": [
            "number",
            "null"
          ],
          "description": "The source's equated z for this font (rank-based); null unless observed or censored."
        },
        "weight_used": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "The weight this source's term carried in the overall rank for this font: v_s = M_g * w'_s / W_g after the outlier guard and the term's factor. Null when the source had no term in overall (not covered, too new, or abstaining)."
        },
        "value": {
          "description": "The value after alias sums, credits and floors; present only when the source's publish_raw allows it (never for google or fot).",
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "enum": [
            null,
            "below_floor",
            "no_value",
            "no_package",
            "outside_frame",
            "merged_into_parent"
          ]
        },
        "abstains_in": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rank_key"
          }
        }
      },
      "description": "One font in one source, as the source's own survey view sees it (desktop_installed or project, where nothing abstains). abstains_in lists the font's views where a Linux source leaves it out (never desktop_installed).",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "rank_in_source": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "censored"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "below_floor",
                  "no_value"
                ]
              }
            }
          }
        },
        {
