#!/usr/bin/python3 -I
"""tff-refresh-watchdog: warn when the monthly catalog refresh looks stalled (milestone-1 step 19).

GitHub turns off a public repository's scheduled workflows after 60 days without
activity, and says nothing. This check runs on the VPS, outside GitHub's scheduler,
once a day, reads GitHub's public API and warns when:

- no refresh pull request has appeared for ``REFRESH_MAX_DAYS`` (35) days. The last
  one "appeared" when its pull request was opened or its branch ``refresh/monthly``
  last got a commit (a run replaces an unmerged pull request by pushing to it);
- ``main`` has had no commit for ``MAIN_MAX_DAYS`` (50) days;
- the refresh workflow is not ``active`` (for example ``disabled_inactivity``).

Warnings go to the journal. Gate CI2 (rec): with a token (a fine-grained personal
access token with Issues read and write on this repository only, given to the unit
as the systemd credential ``github-token``) it also opens one issue, and no second
one while that one is open.

Installed as /usr/local/sbin/tff-refresh-watchdog (root:root 0755) and run daily by
tff-refresh-watchdog.timer; see README.md here. Python 3.13, standard library only.

Exit codes: 0 all fine, 1 a warning (reported), 2 usage, 3 GitHub could not be
read or the issue could not be opened.
"""

# The VPS runs this with the system Python, outside the package, so tff_catalog.fetch is
# out of reach; it makes a handful of GitHub API calls a day.
# ruff: noqa: TID251

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

REPO = "byronshock/trulyfreefonts"
BRANCH = "refresh/monthly"
WORKFLOW = "refresh.yml"
REFRESH_MAX_DAYS = 35
MAIN_MAX_DAYS = 50
ALERT = "issue"  # gate CI2 (rec): open an issue when a token is given; "log" = journal only
ISSUE_TITLE = "Refresh watchdog: the monthly refresh needs attention"
CREDENTIAL = "github-token"  # systemd LoadCredential= name
NO_TOKEN = "none"  # the unit's SetCredential= fallback: no token configured
API = "https://api.github.com"
USER_AGENT = "trulyfreefonts-refresh-watchdog (+https://github.com/byronshock/trulyfreefonts)"
TIMEOUT = 30.0


class ApiError(RuntimeError):
    """GitHub answered with an error, or could not be reached."""


class GitHub:
    """The few REST calls the watchdog makes."""

    def __init__(self, repo: str, token: str | None = None) -> None:
        self.repo = repo
        self.token = token

    def request(self, method: str, path: str, body: object = None) -> tuple[int, Any]:
        """``(status, JSON)``; a 404 returns ``(404, None)``, other errors raise ``ApiError``."""
        headers = {
            "Accept": "application/vnd.github+json",
            "User-Agent": USER_AGENT,
            "X-GitHub-Api-Version": "2022-11-28",
        }
        data = None
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        req = urllib.request.Request(API + path, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                return resp.status, json.loads(resp.read() or b"null")
        except urllib.error.HTTPError as exc:
            if exc.code == 404:
                return 404, None
            raise ApiError(f"{method} {path}: HTTP {exc.code} {exc.reason}") from None
        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
            raise ApiError(f"{method} {path}: {exc}") from None

    def get(self, path: str) -> Any:
        return self.request("GET", path)[1]

    # --- what the checks read ---

    def last_refresh(self) -> datetime | None:
        """When a refresh pull request last appeared: its opening or its branch's newest commit."""
        head = urllib.parse.quote(f"{self.repo.split('/')[0]}:{BRANCH}", safe=":")
        pulls = self.get(
            f"/repos/{self.repo}/pulls?head={head}&state=all&sort=created&direction=desc&per_page=1"
        )
        times = [parse_time(p["created_at"]) for p in pulls or []]
        branch = self.get(f"/repos/{self.repo}/branches/{BRANCH}")  # the API takes the raw slash
        if branch is not None:
            times.append(parse_time(branch["commit"]["commit"]["committer"]["date"]))
        return max(times, default=None)

    def last_main_commit(self) -> datetime | None:
        commit = self.get(f"/repos/{self.repo}/commits/main")
        return None if commit is None else parse_time(commit["commit"]["committer"]["date"])

    def workflow_state(self) -> str | None:
        """The refresh workflow's state ("active", "disabled_inactivity", ...), None if absent."""
        workflow = self.get(f"/repos/{self.repo}/actions/workflows/{WORKFLOW}")
        return None if workflow is None else str(workflow["state"])

    # --- the alert ---

    def open_issue_number(self) -> int | None:
        """The open watchdog issue, if there is one."""
        issues = self.get(f"/repos/{self.repo}/issues?state=open&per_page=100") or []
        for issue in issues:
            if "pull_request" not in issue and issue.get("title") == ISSUE_TITLE:
                return int(issue["number"])
        return None

    def open_issue(self, body: str) -> int:
        status, issue = self.request(
            "POST", f"/repos/{self.repo}/issues", {"title": ISSUE_TITLE, "body": body}
        )
        if status != 201 or issue is None:
            raise ApiError(f"POST /repos/{self.repo}/issues: HTTP {status}")
        return int(issue["number"])


@dataclass(frozen=True, slots=True)
class Seen:
    """What GitHub says, as the checks need it."""

    last_refresh: datetime | None
    last_main_commit: datetime | None
    workflow_state: str | None


def parse_time(text: str) -> datetime:
    """GitHub's ``2026-10-03T06:20:11Z`` as an aware UTC datetime (no zone: UTC)."""
    moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
    return moment.replace(tzinfo=UTC) if moment.tzinfo is None else moment.astimezone(UTC)


def _age(now: datetime, then: datetime) -> str:
    return f"{(now - then).days} days ago ({then.date().isoformat()})"


def check(now: datetime, seen: Seen) -> list[str]:
    """Every warning, in plain words; empty when all is well."""
    warnings = []
    if seen.last_refresh is None:
        warnings.append(f"No refresh pull request (branch {BRANCH}) has ever appeared.")
    elif now - seen.last_refresh > timedelta(days=REFRESH_MAX_DAYS):
        warnings.append(
            f"The last refresh pull request appeared {_age(now, seen.last_refresh)}; "
            f"one is expected every month (limit {REFRESH_MAX_DAYS} days)."
        )
    if seen.last_main_commit is None:
        warnings.append("Could not find the newest commit on main.")
    elif now - seen.last_main_commit > timedelta(days=MAIN_MAX_DAYS):
        warnings.append(
            f"The last commit on main was {_age(now, seen.last_main_commit)}. GitHub turns "
            f"scheduled workflows off after 60 days without activity (limit {MAIN_MAX_DAYS} days)."
        )
    if seen.workflow_state is None:
        warnings.append(f"The workflow {WORKFLOW} was not found on the default branch.")
    elif seen.workflow_state != "active":
        warnings.append(f"The workflow {WORKFLOW} is {seen.workflow_state}, not active.")
    return warnings


def issue_body(warnings: list[str], repo: str) -> str:
    lines = ["The refresh watchdog on the VPS found:", ""]
    lines += [f"- {w}" for w in warnings]
    lines += [
        "",
        "To get the monthly refresh going again:",
        "",
        f"- `gh workflow enable {WORKFLOW} -R {repo}` if the workflow is disabled;",
        f"- `gh workflow run {WORKFLOW} -R {repo}` to run it now, then check the run;",
        "- merge the open refresh pull request, or push any other commit to main: a commit",
        "  on main keeps the schedule alive.",
        "",
        "Close this issue once a refresh pull request has appeared; the watchdog opens a new",
        "one if the problem comes back. See ops/refresh-watchdog/README.md.",
    ]
    return "\n".join(lines) + "\n"


def read_token(path: Path | None) -> str | None:
    """The token from ``path``, else from the unit's credential.

    None when absent, empty or ``NO_TOKEN``, the unit's fallback when
    /etc/tff-refresh-watchdog/github-token does not exist.
    """
    if path is None:
        directory = os.environ.get("CREDENTIALS_DIRECTORY")
        if not directory:
            return None
        path = Path(directory) / CREDENTIAL
    try:
        token = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return None
    return None if token in ("", NO_TOKEN) else token


def log(message: str) -> None:
    print(f"tff-refresh-watchdog: {message}", flush=True)


def alert(gh: GitHub, warnings: list[str], *, dry_run: bool) -> None:
    """Open the watchdog issue unless one is open, the run is dry, or there is no token."""
    if ALERT != "issue" or dry_run:
        log("not opening an issue (dry run)" if dry_run else "alerts go to the journal only")
        return
    if not gh.token:
        log(f"no token (credential {CREDENTIAL}): warnings go to the journal only")
        return
    number = gh.open_issue_number()
    if number is not None:
        log(f"issue #{number} is still open; not opening another")
        return
    log(f"opened issue #{gh.open_issue(issue_body(warnings, gh.repo))}")


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="tff-refresh-watchdog", description=__doc__.splitlines()[0])
    p.add_argument("--repo", default=REPO, help=f"owner/name (default {REPO})")
    p.add_argument("--now", type=parse_time, help="pretend it is this UTC time (ISO 8601)")
    p.add_argument("--token-file", type=Path, help="read the token here instead")
    p.add_argument("--dry-run", action="store_true", help="report only; never open an issue")
    return p.parse_args(argv)


def main(argv: list[str] | None = None, github: type[GitHub] = GitHub) -> int:
    try:
        args = parse_args(sys.argv[1:] if argv is None else argv)
    except SystemExit as exc:
        return 0 if exc.code == 0 else 2
    now = args.now or datetime.now(UTC)
    gh = github(args.repo, read_token(args.token_file))
    try:
        seen = Seen(gh.last_refresh(), gh.last_main_commit(), gh.workflow_state())
    except (ApiError, KeyError, TypeError, ValueError) as exc:  # unreachable, or an odd answer
        log(f"could not read GitHub: {type(exc).__name__}: {exc}")
        return 3
    warnings = check(now, seen)
    if not warnings:
        assert seen.last_refresh is not None
        assert seen.last_main_commit is not None
        log(
            f"ok: last refresh pull request {_age(now, seen.last_refresh)}, "
            f"last commit on main {_age(now, seen.last_main_commit)}, "
            f"{WORKFLOW} {seen.workflow_state}"
        )
        return 0
    for warning in warnings:
        log(f"WARNING: {warning}")
    try:
        alert(gh, warnings, dry_run=args.dry_run)
    except ApiError as exc:
        log(f"could not open the issue: {exc}")
        return 3
    return 1


if __name__ == "__main__":
    sys.exit(main())
