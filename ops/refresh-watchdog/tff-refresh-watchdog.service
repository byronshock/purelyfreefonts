[Unit]
Description=Warn when the monthly catalog refresh looks stalled
Documentation=https://github.com/byronshock/trulyfreefonts/blob/main/ops/refresh-watchdog/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tff-refresh-watchdog
DynamicUser=yes
# Gate CI2 (rec): the fine-grained token that lets the watchdog open an issue.
# Without the file the credential falls back to the placeholder "none", and
# warnings go to the journal only.
LoadCredential=github-token:/etc/tff-refresh-watchdog/github-token
SetCredential=github-token:none
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
