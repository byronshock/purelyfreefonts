# Synthetic family: repeated category (the last counts), inline comments,
# a display name, an alias and the hg mirror as its repository.
name: "Aster Sans"
designer: "Synth Type Foundry"
license: "OFL"
category: "DISPLAY"
category: "SANS_SERIF"
date_added: "2021-03-04"
fonts {
  name: "Aster Sans"
  style: "normal"
  weight: 400
  filename: "AsterSans-Regular.ttf"
  post_script_name: "AsterSans-Regular"
  full_name: "Aster Sans Regular"
  copyright: "Copyright 2021 The Aster Sans Project Authors (https://github.com/synth/astersans)"
}
fonts {
  name: "Aster Sans"
  style: "italic"
  weight: 400
  filename: "AsterSans-Italic.ttf"
  post_script_name: "AsterSans-Italic"
  full_name: "Aster Sans Italic"
  copyright: "Copyright 2021 The Aster Sans Project Authors (https://github.com/synth/astersans)"
}
fonts {
  name: "Aster Sans"
  style: "normal"
  weight: 700
  filename: "AsterSans-Bold.ttf"
  post_script_name: "AsterSans-Bold"
  full_name: "Aster Sans Bold"
  copyright: "Copyright 2021 The Aster Sans Project Authors (https://github.com/synth/astersans)"
}
aliases: "Aster Grotesk"
subsets: "cyrillic"
subsets: "latin"
subsets: "menu"
source {
  repository_url: "https://github.com/googlefonts/googlefontdirectory-hg"
}
languages: "de_Latn"  # German, Latin
languages: "en_Latn"  # English, Latin
languages: "ru_Cyrl"  # Russian, Cyrillic
display_name: "Äster Sans"
classifications: "DISPLAY"
