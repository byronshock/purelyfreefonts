{#-
  _filters.html.j2: the filter controls (M2-D4; site/CONTRACT.md, "The list page"). Native,
  labelled controls in fieldsets inside <search>, never a <form> (the CSP has form-action
  'none'). Each control's name is its hash key and its value the key's value (CONTRACT
  section 9). The block ships with `hidden`; the script removes it, and 25-filters.css
  reserves its space so that doesn't move the list. Below 60rem everything but search and
  rank sits behind #f-toggle, whose aria-expanded drives the disclosure. Spacing follows the
  owner's site ruling of 2026-09-25 (data/reviews/site/2026-09-25.toml), and "Nerd Font
  available" the one of 2026-09-29 (2026-09-29.toml, nerd_filter), described by the legend.
-#}
<search id="filters" class="filters" aria-label="Filter fonts" hidden>
<div class="filters-bar">
<label for="f-q">Search fonts</label>
<input id="f-q" name="q" type="search" maxlength="100" autocomplete="off" spellcheck="false">
<label for="f-rank">Rank</label>
<select id="f-rank" name="rank" aria-describedby="f-rank-measures">
{% for view in list.views %}
<option value="{{ view.key }}"{% if loop.first %} selected{% endif %}>{{ view.label }}</option>
{% endfor %}
</select>
<p id="f-rank-measures" class="measures">{{ list.views[0].measures }}</p>
<button type="button" id="f-toggle" class="filters-toggle" aria-expanded="false" aria-controls="f-more">Filters<span class="filters-count"></span></button>
</div>
<div id="f-more" class="filters-more">
<fieldset id="f-cat">
<legend>Category</legend>
<label class="opt"><input type="radio" id="f-cat-all" name="cat" value="" checked> Any</label>
{% for cat in list.categories %}
<label class="opt"><input type="radio" id="f-cat-{{ cat.value }}" name="cat" value="{{ cat.value }}"> {{ cat.label }}</label>
{% endfor %}
</fieldset>
<fieldset id="f-spacing">
<legend>Spacing</legend>
<label class="opt"><input type="radio" id="f-spacing-any" name="spacing" value="" checked> Any</label>
<label class="opt"><input type="radio" id="f-spacing-proportional" name="spacing" value="proportional"> Proportional</label>
<label class="opt"><input type="radio" id="f-spacing-monospaced" name="spacing" value="monospaced"> Monospaced</label>
</fieldset>
<fieldset id="f-type">
<legend>Type</legend>
<label class="opt"><input type="checkbox" id="f-var" name="var" value="1"> Variable fonts only</label>
<label class="opt"><input type="checkbox" id="f-nerd" name="nerd" value="1" aria-describedby="nf-legend"> Nerd Font available</label>
<label class="opt"><input type="checkbox" id="f-hide-limited" name="hide" value="limited" aria-describedby="f-hide-limited-help"> Hide limited accents</label>
<p id="f-hide-limited-help" class="hint">Fonts that cover basic Latin only, without the accented letters of languages such as Polish or Czech.</p>
</fieldset>
<fieldset id="f-license">
<legend>License</legend>
<fieldset class="subgroup">
<legend>Show only</legend>
{% for cls in list.license_classes %}
<label class="opt"><input type="checkbox" id="f-lic-{{ cls.id }}" name="lic" value="{{ cls.id }}"> {{ cls.label }}</label>
{% endfor %}
</fieldset>
<label class="opt"><input type="checkbox" id="f-hide-attr" name="hide" value="attr"> Hide attribution required</label>
<label class="opt"><input type="checkbox" id="f-redist" name="redist" value="1" aria-describedby="f-redist-help"> Redistributable fonts only</label>
<p id="f-redist-help" class="hint">Redistributing means passing the font files on, for example inside an app or on your own website. Every font here is free to use; this hides the ones whose license forbids passing the files on.</p>
</fieldset>
<fieldset id="f-system">
<legend>Hide fonts that come with</legend>
{% for system in list.systems_os %}
<label class="opt"><input type="checkbox" id="f-hide-{{ system.value }}" name="hide" value="{{ system.value }}"> {{ system.label }}</label>
{% endfor %}
</fieldset>
<fieldset id="f-sort">
<legend>Sort</legend>
<label class="opt"><input type="radio" id="f-sort-rank" name="sort" value="rank" checked> By rank</label>
<label class="opt"><input type="radio" id="f-sort-name" name="sort" value="name"> By name</label>
</fieldset>
<button type="button" id="f-clear">Clear filters</button>
</div>
</search>
