{#-
  base.html.j2: the shell every page extends. Block names and the template context are
  frozen in site/CONTRACT.md ("Templates"). No inline <script>, <style>, style="" or on*=""
  anywhere: the CSP blocks them. Rendered with autoescape and StrictUndefined.

  Every page gets the same header, the same footer and, in the footer, the one feedback spot
  (M2-D10; WCAG 3.2.6 wants help in the same place on every page) and the privacy line. The
  page's one <h1> is the first thing in its `main` block. Styles: site/css/10-base.css.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ page.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ page.description }}{% endblock %}">
{% if page.canonical %}
<link rel="canonical" href="{{ site.base_url }}{{ page.path }}">
{% endif %}
<meta name="color-scheme" content="light dark">
{# Share previews. The image lives on our own domain; nothing is fetched from anywhere else. #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
{% if page.canonical %}
<meta property="og:url" content="{{ site.base_url }}{{ page.path }}">
{% endif %}
<meta property="og:image" content="{{ site.base_url }}/share.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}: the most popular fonts whose licenses allow all personal and commercial use.">
<meta name="twitter:card" content="summary_large_image">
{# The .ico's sizes="32x32" keeps browsers that understand SVG icons on the SVG. #}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="{{ assets.font }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ assets.css }}">
{# M2 step 7b: once a post is published, feed readers find the blog's Atom feed from any page. #}
{% if site.blog %}
<link rel="alternate" type="application/atom+xml" title="{{ site.name }} blog" href="{{ site.blog.feed_url }}">
{% endif %}
{% block scripts %}
<script type="module" src="{{ assets.js }}"></script>
{% endblock %}
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
{% block header %}
{# The wordmark (owner rulings of 2026-10-06, AUTHORITY.md "Headline font"): the owner's 9717 x 1400 plate, 410 x 59 on wide screens. #}
<a class="site-name" href="/"><img class="site-name-mark" src="/wordmark.svg" alt="{{ site.name }}" width="410" height="59"></a>
<nav class="site-nav" aria-label="Site">
<ul>
{# The Blog link appears once a post is published (M2 step 7b: site.blog). #}
{% set blog_link = [(site.blog.url, "Blog")] if site.blog else [] %}
{# "How it works" leads to "How we measure popularity" (owner's site ruling of 2026-10-05, method_page_name). #}
{% for href, label in [("/", "Fonts"), ("/methodology/", "How it works")] + blog_link + [("/about/", "About"), ("/privacy/", "Privacy")] %}
<li><a href="{{ href }}"{% if page.path == href %} aria-current="page"{% endif %}>{{ label }}</a></li>
{% endfor %}
</ul>
</nav>
{# Milestone 2 step 14: the page says it is an early version and what comes next. Milestone 3 removes it. Phones don't show it (owner's site ruling of 2026-10-06, early_line_hidden_on_phones). #}
<p class="site-status">Early version. Coming next: free font inventory tools.</p>
{% endblock %}
</header>
<main id="main" tabindex="-1">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
{% block footer %}
<div class="feedback" id="feedback">
{% block feedback %}
<p>Something wrong or missing? <a href="{{ site.feedback.issues_url }}">Report it on GitHub</a>, or email <a href="{{ site.feedback.mailto }}">{{ site.feedback.email }}</a>.</p>
{% endblock %}
</div>
{# ops/DONATIONS.md step 11: one plain link to Stripe's hosted page; no Stripe script, no cookie. A tip, never a donation. #}
{% block tip_link %}
{% if site.tip_url %}
<p class="tip" id="tip">Find the list useful? <a href="{{ site.tip_url }}">Leave a tip ($5 suggested)</a> on Stripe's payment page.</p>
{% endif %}
{% endblock %}
{# The privacy line, on every page (owner's site ruling of 2026-10-07, privacy_line_in_footer); the Privacy page says how to check. #}
<p class="footer-privacy">No cookies, no tracking, and the page loads only its own files. <a href="/privacy/#check-for-yourself">Check the Network tab</a>.</p>
<p class="footer-meta">Data from {{ build.run_date }}. <a href="{{ site.repo_url }}">Source code on GitHub</a>.</p>
{% endblock %}
</footer>
</body>
</html>
