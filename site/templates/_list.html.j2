{#-
  _list.html.j2: the whole list (filters, no-script note, count, rows), laid out per M2-D4.
  Ids, classes and data- attributes are frozen in site/CONTRACT.md, "The list page"; the
  scripts find everything through them. Font index i is the i-th li.font below. Needs `list`
  and `build` from the context; a later /check/ page includes this file unchanged.
  role="list" looks redundant, but Safari drops list semantics from lists styled with
  list-style: none, and step 6 wants each font announced as a list item. #nf-legend is the
  owner's legend for the rows' "NF" marker (config/site.toml [nerd]). #list-sort, the sort
  buttons over the rank and name columns, ships hidden like #filters and is shown by the
  script (owner ruling of 2026-09-30, sort_header). The buttons carry their own words for
  each order; the script redraws them (30-filters-ui.js).
-#}
<div class="layout">
{% include "_filters.html.j2" %}
<noscript><p class="noscript-note">Filters and search need JavaScript. Below is the full list, ranked by use in projects.</p></noscript>
<section id="results" class="results" aria-labelledby="results-h">
<h2 id="results-h">Fonts</h2>
<p id="ext-summary" class="ext-summary" hidden></p>
<p id="count" class="count">Showing {{ list.total }} of {{ list.total }} {{ "font" if list.total == 1 else "fonts" }}</p>
<p id="nf-legend" class="nf-legend"><span class="nf-mark">{{ list.nerd.marker }}</span>{{ list.nerd.after_marker }}</p>
<p id="held-legend" class="held-legend is-held"{% if not list.held_shown %} hidden{% endif %}><i class="bar b60"></i> {{ list.held_legend }}</p>
<p id="view-note" class="view-note" hidden></p>
<div id="status" class="visually-hidden" role="status"></div>
<div id="no-results" class="no-results" hidden>
<p id="no-results-text">No fonts match these filters. Try loosening some of them.</p>
<button type="button" id="no-results-clear">Clear filters</button>
</div>
<div id="list-sort" class="list-sort" role="group" aria-label="Sort the list" hidden>
<button type="button" class="sort-btn" id="sort-rank" data-sort="rank" data-asc="best first" data-desc="least used first" data-asc-spoken="best first" data-desc-spoken="least used first" aria-pressed="true" data-dir="asc" title="Show least used first instead"><span class="visually-hidden">Sort by </span><span class="sort-label">Rank</span> <span class="sort-arrow" aria-hidden="true"></span> <span class="sort-dir"><span aria-hidden="true">best first</span><span class="visually-hidden"> best first; select to show least used first</span></span></button>
<button type="button" class="sort-btn" id="sort-name" data-sort="name" data-asc="A&#x2013;Z" data-desc="Z&#x2013;A" data-asc-spoken="A to Z" data-desc-spoken="Z to A" aria-pressed="false" title="Sort by name"><span class="visually-hidden">Sort by </span><span class="sort-label">Name</span> <span class="sort-arrow" aria-hidden="true"></span> <span class="sort-dir"></span></button>
</div>
<ol id="list" class="font-list" role="list" data-index="{{ list.index_url }}" data-details="{{ list.details_url }}" data-run-date="{{ build.run_date }}">
{% for row in list.rows %}
{% include "_row.html.j2" %}
{% endfor %}
</ol>
</section>
</div>
