{#-
  _list.html.j2: the whole list (filters, no-script note, count, rows), laid out per M2-D4.
  Ids, classes and data- attributes are frozen in site/CONTRACT.md, "The list page"; the
  scripts find everything through them. Font index i is the i-th li.font below. Needs `list`
  and `build` from the context; a later /check/ page includes this file unchanged.
  role="list" looks redundant, but Safari drops list semantics from lists styled with
  list-style: none, and step 6 wants each font announced as a list item. #nf-legend is the
  owner's legend for the rows' "NF" marker (config/site.toml [nerd]). #sort-by, beside the
  count, ships hidden like #filters and is shown by the script (owner ruling of 2026-09-30,
  filters_layout).
-#}
<div class="layout">
{% include "_filters.html.j2" %}
<noscript><p class="noscript-note">Filters and search need JavaScript. Below is the full list by overall rank.</p></noscript>
<section id="results" class="results" aria-labelledby="results-h">
<h2 id="results-h">Fonts</h2>
<p id="ext-summary" class="ext-summary" hidden></p>
<div class="list-head">
<p id="count" class="count">Showing {{ list.total }} of {{ list.total }} {{ "font" if list.total == 1 else "fonts" }}</p>
<p id="sort-by" class="sort-by" hidden><label for="f-sort">Sort</label> <select id="f-sort" name="sort"><option value="rank" selected>By rank</option><option value="name">By name</option></select></p>
</div>
<p id="nf-legend" class="nf-legend"><span class="nf-mark">{{ list.nerd.marker }}</span>{{ list.nerd.after_marker }}</p>
<div id="status" class="visually-hidden" role="status"></div>
<div id="no-results" class="no-results" hidden>
<p id="no-results-text">No fonts match these filters. Try loosening some of them.</p>
<button type="button" id="no-results-clear">Clear filters</button>
</div>
<ol id="list" class="font-list" role="list" data-index="{{ list.index_url }}" data-details="{{ list.details_url }}" data-run-date="{{ build.run_date }}">
{% for row in list.rows %}
{% include "_row.html.j2" %}
{% endfor %}
</ol>
</section>
</div>
